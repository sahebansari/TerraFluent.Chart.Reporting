{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "*" ]
  },
  "ApiKey": "",
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 1000,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "Limits": {
    "MaxRequestBodyBytes": 10485760
  },
  "Session": {
    "IdleTimeoutMinutes": 30,
    "Capacity": 200
  }
}
