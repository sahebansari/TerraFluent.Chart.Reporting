{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Connections": {
    "Sales": {
      "Kind": "http",
      "Target": "https://internal.example.com/api/sales",
      "Description": "Nightly sales extract",
      "MaxRows": 50000,
      "TimeoutSeconds": 20,
      "Settings": {
        "jsonPath": "data.rows",
        "header.Authorization": "Bearer ..."
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "*" ]
  },
  "ApiKey": "",
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 1000,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "Limits": {
    "MaxRequestBodyBytes": 10485760
  },
  "Session": {
    "IdleTimeoutMinutes": 30,
    "Capacity": 200
  }
}
