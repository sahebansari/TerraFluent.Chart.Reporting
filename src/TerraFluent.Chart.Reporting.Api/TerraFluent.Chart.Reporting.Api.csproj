<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TerraFluent.Chart.Reporting.Api</RootNamespace>
    <AssemblyName>TerraFluent.Chart.Reporting.Api</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Suppress missing-XML-doc warnings from generated code -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Self-hosted Inter woff2 embedded for self-contained HTML exports (see EmbeddedFontCss). -->
    <EmbeddedResource Include="Rendering\Fonts\*.woff2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TerraFluent.Chart.Reporting\TerraFluent.Chart.Reporting.csproj" />
    <ProjectReference Include="..\..\src\TerraFluent.AutoAnalytics\TerraFluent.AutoAnalytics.csproj" />
  </ItemGroup>

</Project>
