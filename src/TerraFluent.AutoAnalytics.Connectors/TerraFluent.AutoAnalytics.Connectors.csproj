<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TerraFluent.AutoAnalytics.Connectors</RootNamespace>
    <AssemblyName>TerraFluent.AutoAnalytics.Connectors</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <PackageId>TerraFluent.AutoAnalytics.Connectors</PackageId>
    <Version>1.0.0</Version>
    <Authors>TerraFluent</Authors>
    <Company>TerraFluent</Company>
    <Description>Live source connectors for TerraFluent.AutoAnalytics. Ships separately so the
      analytics core stays dependency-free: consumers who only analyse files never pull these in.
      Connections are configured server-side and selected by name, so credentials never reach a client.</Description>
    <PackageTags>analytics;connector;datasource;http;json;etl;dotnet</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TerraFluent.AutoAnalytics\TerraFluent.AutoAnalytics.csproj" />
  </ItemGroup>

</Project>
